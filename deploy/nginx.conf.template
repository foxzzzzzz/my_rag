# Replace placeholders with your own certificate paths. Add as a separate vhost.
server {
    listen 80; server_name __HOSTNAME__;
    location /.well-known/acme-challenge/ { root __ACME_ROOT__; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl; server_name __HOSTNAME__;
    ssl_certificate __CERTIFICATE__; ssl_certificate_key __PRIVATE_KEY__;
    client_max_body_size 1g;
    location / {
        proxy_pass http://127.0.0.1:__APP_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_next_upstream off;
        proxy_buffering off; proxy_read_timeout 3600s; proxy_send_timeout 3600s;
    }
}
