# Only these two API keys need to be filled for this demo.
# Alibaba Cloud Model Studio: China (Beijing), standard pay-as-you-go API key.
# The same key is used for Paraformer ASR and Qwen vision.
DASHSCOPE_API_KEY=

# DeepSeek platform API key, used for summaries and Markdown notes.
DEEPSEEK_API_KEY=

# Optional: absolute FFmpeg executable path; leave empty for auto-detection.
FFMPEG_PATH=

# Optional future managed OSS mode only. Keep empty for temporary uploads.
# Select backend=managed_oss explicitly in config/asr-storage.json after setup.
# Use restricted RAM credentials; security token is optional for STS.
PERSONALKB_OSS_ACCESS_KEY_ID=
PERSONALKB_OSS_ACCESS_KEY_SECRET=
PERSONALKB_OSS_SECURITY_TOKEN=

# 可选抖音手动Cookie，仅本地/服务器私密配置，绝不粘贴到聊天
PERSONALKB_DOUYIN_COOKIE=
